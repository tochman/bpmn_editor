# Supabase Configuration
# You can use an existing Supabase project or create a new one.
# These values are required in local development and in Netlify deployment settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SITE_URL=https://your-site-name.netlify.app

# Note: This app uses 'bpmn_profiles' and 'bpmn_diagrams' tables.
# Run the schema in supabase/schema.sql to create the required tables.
